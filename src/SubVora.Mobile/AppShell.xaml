<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SubVora.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SubVora.Mobile.Views"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:DashboardViewModel"
    Title="SubVora">

    <Shell.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
    </Shell.Resources>

    <!--
        One strip, two states. The offline notice sits on top of the spend summary rather than
        beside it: the title bar has room for one line, and "these numbers may be stale" is the
        more urgent thing to say when both are true.
    -->
    <Shell.TitleView>
        <Grid>
            <Label x:Name="BurnRateBanner"
                   Text="{Binding Summary}"
                   BackgroundColor="#512BD4"
                   TextColor="White"
                   FontSize="13"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   Padding="4"
                   IsVisible="{Binding Summary, Converter={StaticResource StringToBoolConverter}}" />

            <Label x:Name="OfflineBanner"
                   Text="You're offline — showing saved data"
                   BackgroundColor="OrangeRed"
                   TextColor="White"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   Padding="4"
                   IsVisible="False" />
        </Grid>
    </Shell.TitleView>

    <TabBar>
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage" />

        <ShellContent
            Title="Subscriptions"
            ContentTemplate="{DataTemplate views:SubscriptionListPage}"
            Route="SubscriptionListPage" />

        <ShellContent
            Title="Categories"
            ContentTemplate="{DataTemplate views:CategoriesPage}"
            Route="CategoriesPage" />

        <ShellContent
            Title="Payment Sources"
            ContentTemplate="{DataTemplate views:PaymentSourcesPage}"
            Route="PaymentSourcesPage" />

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
