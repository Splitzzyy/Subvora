<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:RegisterViewModel"
    Shell.NavBarIsVisible="False"
    Title="Register">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*">

            <VerticalStackLayout Grid.Row="1" Spacing="20">

                <VerticalStackLayout Spacing="4" Margin="0,0,0,8">
                    <Label Style="{StaticResource Display}" Text="Create account" HorizontalTextAlignment="Center" FontSize="28" />
                    <Label Style="{StaticResource Caption}"
                           Text="Takes a few seconds. No card needed."
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />
                        </Border>

                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />
                        </Border>

                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Placeholder="Confirm password" IsPassword="True" Text="{Binding ConfirmPassword}" />
                        </Border>

                        <Label Style="{StaticResource ErrorText}"
                               Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                        <Button Text="Create account"
                                Command="{Binding RegisterCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <Button Style="{StaticResource LinkButton}"
                        Text="Already have an account? Log in"
                        Clicked="OnLoginTapped" />

            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
