<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:dtos="clr-namespace:SubVora.Mobile.Api.Dtos"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:SubVora.Mobile.Converters"
    x:DataType="viewModels:DashboardViewModel"
    Title="Dashboard">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <converters:CategoryColorConverter x:Key="CategoryColorConverter" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,32" Spacing="16">

                <Label Style="{StaticResource Caption}"
                       Text="Offline — showing last synced data"
                       FontAttributes="Italic"
                       IsVisible="{Binding IsShowingCachedData}" />

                <Label Style="{StaticResource WarningText}"
                       Text="{Binding WarningMessage}"
                       IsVisible="{Binding WarningMessage, Converter={StaticResource StringToBoolConverter}}" />

                <Label Style="{StaticResource ErrorText}"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                <!-- Weekly is the headline because it is the number that changes behaviour; monthly
                     and yearly sit under it as context rather than as three equal-weight lines. -->
                <Border Style="{StaticResource HeroCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="SPENDING PER WEEK"
                               FontSize="12"
                               FontAttributes="Bold"
                               CharacterSpacing="1.4"
                               TextColor="#D8D2F5" />

                        <Label FontSize="40" FontAttributes="Bold" TextColor="White">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding HomeCurrency}" FontSize="20" />
                                    <Span Text=" " />
                                    <Span Text="{Binding Weekly, StringFormat='{0:N2}'}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <BoxView HeightRequest="1" Color="#7C5CE0" Margin="0,12" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Monthly" FontSize="12" TextColor="#D8D2F5" />
                                <Label Text="{Binding Monthly, StringFormat='{0:N2}'}"
                                       FontSize="17" FontAttributes="Bold" TextColor="White" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Yearly" FontSize="12" TextColor="#D8D2F5" />
                                <Label Text="{Binding Yearly, StringFormat='{0:N2}'}"
                                       FontSize="17" FontAttributes="Bold" TextColor="White" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="One-time" FontSize="12" TextColor="#D8D2F5" />
                                <Label Text="{Binding OneTimeThisYear, StringFormat='{0:N2}'}"
                                       FontSize="17" FontAttributes="Bold" TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionHeading}" Text="By category" Margin="4,4,0,0" />

                <Border Style="{StaticResource Card}" Padding="18,4">
                    <CollectionView ItemsSource="{Binding ByCategory}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:CategoryBreakdownItem">
                                <!--
                                    Name and amount are always printed. The dot and the bar share one
                                    colour per category, but neither carries identity on its own -
                                    beyond three categories on screen no eight-hue palette keeps
                                    every arbitrary pair distinguishable, so the label is the cue and
                                    the colour is reinforcement.
                                -->
                                <Grid Style="{StaticResource CardRow}"
                                      ColumnDefinitions="Auto,*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      RowSpacing="6">

                                    <Ellipse Grid.Row="0" Grid.Column="0"
                                             WidthRequest="10" HeightRequest="10"
                                             VerticalOptions="Center"
                                             Margin="0,0,10,0"
                                             Fill="{Binding CategoryName, Converter={StaticResource CategoryColorConverter}}" />

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource BodyText}"
                                           Text="{Binding CategoryName}"
                                           VerticalOptions="Center" />

                                    <Label Grid.Row="0" Grid.Column="2"
                                           Style="{StaticResource BodyStrong}"
                                           Text="{Binding MonthlyAmount, StringFormat='{0:N2}'}"
                                           VerticalOptions="Center" />

                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                 Progress="{Binding Share}"
                                                 ProgressColor="{Binding CategoryName, Converter={StaticResource CategoryColorConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="0,26" Spacing="6">
                                <Label Style="{StaticResource EmptyTitle}" Text="Nothing tracked yet" />
                                <Label Style="{StaticResource EmptyBody}"
                                       Text="Add a subscription and your spend will break down by category here." />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
