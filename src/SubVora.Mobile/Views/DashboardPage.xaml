<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:dtos="clr-namespace:SubVora.Mobile.Api.Dtos"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:SubVora.Mobile.Converters"
    x:DataType="viewModels:DashboardViewModel"
    Title="Dashboard">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <converters:CategoryColorConverter x:Key="CategoryColorConverter" />
        <converters:CategoryIconConverter x:Key="CategoryIconConverter" />
        <converters:CurrencySymbolConverter x:Key="CurrencySymbolConverter" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,32" Spacing="16">

                <Label Style="{StaticResource Caption}"
                       Text="Offline — showing last synced data"
                       FontAttributes="Italic"
                       IsVisible="{Binding IsShowingCachedData}" />

                <Label Style="{StaticResource WarningText}"
                       Text="{Binding WarningMessage}"
                       IsVisible="{Binding WarningMessage, Converter={StaticResource StringToBoolConverter}}" />

                <Label Style="{StaticResource ErrorText}"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                <!--
                    Weekly is the headline because it is the number that changes behaviour; monthly,
                    yearly and one-time sit below as their own tiles rather than as three more lines
                    of white text inside the hero, where they competed with it.
                -->
                <Border Style="{StaticResource HeroCard}">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="SPENDING PER WEEK"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.4"
                                   TextColor="#DCD5FA"
                                   VerticalOptions="Center" />

                            <!-- Translucent white, so the badge sits on the gradient without needing
                                 a second brand colour that would compete with the figure. -->
                            <Border Grid.Column="1"
                                    BackgroundColor="#33FFFFFF"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    Padding="9,5"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5">
                                    <Path Data="{StaticResource IconTrendingUp}"
                                          Aspect="Uniform"
                                          WidthRequest="13" HeightRequest="13"
                                          Fill="#FFFFFF"
                                          VerticalOptions="Center" />
                                    <Label Text="{Binding HomeCurrency}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           CharacterSpacing="0.6"
                                           TextColor="#FFFFFF"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Label Grid.Row="1" FontSize="44" FontAttributes="Bold" TextColor="White" Margin="0,6,0,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding HomeCurrency, Converter={StaticResource CurrencySymbolConverter}}" FontSize="26" />
                                    <Span Text=" " />
                                    <Span Text="{Binding Weekly, StringFormat='{0:N2}'}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Grid.Row="2"
                               Style="{StaticResource Caption}"
                               Text="Your recurring burn rate, converted to your home currency."
                               TextColor="#C9BEF5"
                               Margin="0,2,0,0" />
                    </Grid>
                </Border>

                <!-- One tile per horizon. Same three numbers as before, but each with its own icon,
                     accent and surface, so they read as three facts rather than one run-on line. -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                    <Border Grid.Column="0" Style="{StaticResource StatTile}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentBlueSoftLight}, Dark={StaticResource AccentBlueSoftDark}}">
                        <VerticalStackLayout Spacing="7">
                            <Path Data="{StaticResource IconCalendar}"
                                  Aspect="Uniform"
                                  WidthRequest="19" HeightRequest="19"
                                  Fill="{AppThemeBinding Light={StaticResource AccentBlueLight}, Dark={StaticResource AccentBlueDark}}"
                                  HorizontalOptions="Start" />
                            <Label Style="{StaticResource StatValue}" Text="{Binding Monthly, StringFormat='{0:N0}'}" />
                            <Label Style="{StaticResource StatLabel}" Text="Monthly" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatTile}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentTealSoftLight}, Dark={StaticResource AccentTealSoftDark}}">
                        <VerticalStackLayout Spacing="7">
                            <Path Data="{StaticResource IconSchedule}"
                                  Aspect="Uniform"
                                  WidthRequest="19" HeightRequest="19"
                                  Fill="{AppThemeBinding Light={StaticResource AccentTealLight}, Dark={StaticResource AccentTealDark}}"
                                  HorizontalOptions="Start" />
                            <Label Style="{StaticResource StatValue}" Text="{Binding Yearly, StringFormat='{0:N0}'}" />
                            <Label Style="{StaticResource StatLabel}" Text="Yearly" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatTile}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentAmberSoftLight}, Dark={StaticResource AccentAmberSoftDark}}">
                        <VerticalStackLayout Spacing="7">
                            <Path Data="{StaticResource IconPayments}"
                                  Aspect="Uniform"
                                  WidthRequest="19" HeightRequest="19"
                                  Fill="{AppThemeBinding Light={StaticResource AccentAmberLight}, Dark={StaticResource AccentAmberDark}}"
                                  HorizontalOptions="Start" />
                            <Label Style="{StaticResource StatValue}" Text="{Binding OneTimeThisYear, StringFormat='{0:N0}'}" />
                            <Label Style="{StaticResource StatLabel}" Text="One-time" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Where the money leaves from, above the category split: "what am I buying" is
                     the second question, "which card is this landing on" is the one that decides
                     whether a statement makes sense. Hidden entirely when there is one payment
                     source or none - a breakdown of one row is a list with nothing to compare. -->
                <HorizontalStackLayout Spacing="8" Margin="4,6,0,0"
                                       IsVisible="{Binding TopSpendSourceSummary, Converter={StaticResource StringToBoolConverter}}">
                    <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconCreditCard}" />
                    <Label Style="{StaticResource SectionHeading}" Text="Where it's charged" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border Style="{StaticResource Card}" Padding="14,10"
                        IsVisible="{Binding TopSpendSourceSummary, Converter={StaticResource StringToBoolConverter}}">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource BodyStrong}" Text="{Binding TopSpendSourceSummary}" />

                        <!-- BindableLayout, not a CollectionView: this list is short and already
                             inside the page's ScrollView, and nesting a scrolling control collapses
                             its height on Android. -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ByPaymentSource}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:PaymentSourceBreakdownItem">
                                    <Grid Style="{StaticResource CardRow}"
                                          ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="8">

                                        <Label Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource BodyText}"
                                               Text="{Binding PaymentSourceLabel}"
                                               VerticalOptions="Center" />

                                        <Label Grid.Row="0" Grid.Column="1"
                                               Style="{StaticResource BodyStrong}"
                                               Text="{Binding MonthlyAmount, StringFormat='{0:N2}'}"
                                               VerticalOptions="Center" />

                                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                     Progress="{Binding Share}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="8" Margin="4,6,0,0">
                    <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconTag}" />
                    <Label Style="{StaticResource SectionHeading}" Text="By category" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border Style="{StaticResource Card}" Padding="14,6">
                    <CollectionView ItemsSource="{Binding ByCategory}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:CategoryBreakdownItem">
                                <!--
                                    Name and amount are always printed. The tile, its glyph and the
                                    bar share one colour per category, but none of them carries
                                    identity alone - beyond three categories on screen no eight-hue
                                    palette keeps every arbitrary pair distinguishable, so the label
                                    is the cue and the colour is reinforcement.
                                -->
                                <Grid Style="{StaticResource CardRow}"
                                      ColumnDefinitions="Auto,*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      RowSpacing="8">

                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                            Style="{StaticResource IconTile}"
                                            Margin="0,0,12,0"
                                            BackgroundColor="{Binding CategoryName, Converter={StaticResource CategoryColorConverter}, ConverterParameter=soft}">
                                        <Path Style="{StaticResource IconTileGlyph}"
                                              Data="{Binding CategoryName, Converter={StaticResource CategoryIconConverter}}"
                                              Fill="{Binding CategoryName, Converter={StaticResource CategoryColorConverter}}" />
                                    </Border>

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource BodyStrong}"
                                           Text="{Binding CategoryName}"
                                           VerticalOptions="Center" />

                                    <Label Grid.Row="0" Grid.Column="2"
                                           Style="{StaticResource BodyStrong}"
                                           Text="{Binding MonthlyAmount, StringFormat='{0:N2}'}"
                                           VerticalOptions="Center" />

                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                 Progress="{Binding Share}"
                                                 ProgressColor="{Binding CategoryName, Converter={StaticResource CategoryColorConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="0,26" Spacing="10">
                                <Path Style="{StaticResource EmptyIcon}" Data="{StaticResource IconTag}" />
                                <Label Style="{StaticResource EmptyTitle}" Text="Nothing tracked yet" />
                                <Label Style="{StaticResource EmptyBody}"
                                       Text="Add a subscription and your spend will break down by category here." />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
