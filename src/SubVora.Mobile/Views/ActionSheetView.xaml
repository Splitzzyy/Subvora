<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Compact dropdown menu, standing in for DisplayActionSheetAsync.

    The platform action sheet is an unstyled list of strings in a system alert - it cannot take the
    app's shape, colour or type scale. This was first built as a full-width bottom sheet, which was
    far too heavy for two choices; it is now a small menu card, the shape a row-level "..." button
    is expected to open.
-->
<ContentView
    x:Class="SubVora.Mobile.Views.ActionSheetView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
            Stroke="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}"
            StrokeThickness="1"
            WidthRequest="232"
            Padding="6">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="18" />
        </Border.StrokeShape>

        <!-- A real shadow, because the menu floats over content rather than sitting on the page.
             The toolkit's own popup shadow is switched off - it wrapped the whole container and
             rounded it a second time. -->
        <Border.Shadow>
            <Shadow Brush="#000000" Opacity="0.22" Radius="18" Offset="0,6" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="0">

            <!-- Which row this menu belongs to. The toolkit cannot anchor a popup to the control
                 that opened it, so without the name there is nothing tying the menu to its row. -->
            <Label x:Name="TitleLabel"
                   Style="{StaticResource Caption}"
                   FontSize="12"
                   FontAttributes="Bold"
                   Margin="12,8,12,6"
                   LineBreakMode="TailTruncation" />

            <VerticalStackLayout x:Name="ActionsLayout" Spacing="2" />

        </VerticalStackLayout>
    </Border>
</ContentView>
