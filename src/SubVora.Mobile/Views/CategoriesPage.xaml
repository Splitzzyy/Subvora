<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:dtos="clr-namespace:SubVora.Mobile.Api.Dtos"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:SubVora.Mobile.Converters"
    x:DataType="viewModels:CategoriesViewModel"
    Title="Categories">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <converters:CategoryColorConverter x:Key="CategoryColorConverter" />
        <converters:CategoryIconConverter x:Key="CategoryIconConverter" />
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <Grid RowDefinitions="Auto,Auto,*" Padding="16,16,16,0" RowSpacing="12">

            <Label Grid.Row="0"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource FieldBorder}">
                    <Entry Placeholder="New category" Text="{Binding NewCategoryName}" />
                </Border>
                <Button Grid.Column="1" Text="Add" Command="{Binding AddCommand}" IsEnabled="{Binding CanSubmit}" Padding="20,14" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,4" Margin="0,0,0,16">
                <CollectionView ItemsSource="{Binding Categories}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dtos:CategoryDto">
                            <!-- Swipe actions rather than inline buttons: the row is mostly a name,
                                 and two buttons per row would crowd out the thing being named.
                                 Hidden entirely for system defaults - they are shared by every
                                 account, and the server answers 404 for them anyway. -->
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Rename"
                                                   BackgroundColor="#512BD4"
                                                   IsVisible="{Binding IsSystemDefault, Converter={StaticResource InvertedBoolConverter}}"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CategoriesViewModel}}, Path=RenameCommand}"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Delete"
                                                   BackgroundColor="#C62828"
                                                   IsVisible="{Binding IsSystemDefault, Converter={StaticResource InvertedBoolConverter}}"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CategoriesViewModel}}, Path=DeleteCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                            <Grid Style="{StaticResource CardRow}" ColumnDefinitions="Auto,*,Auto">
                                <!-- Tile rather than the old 10px dot: at that size the colour was
                                     the only thing distinguishing one row from the next, and a hue
                                     alone cannot say "Fitness". -->
                                <Border Grid.Column="0"
                                        Style="{StaticResource IconTile}"
                                        Margin="0,0,12,0"
                                        BackgroundColor="{Binding Name, Converter={StaticResource CategoryColorConverter}, ConverterParameter=soft}">
                                    <Path Style="{StaticResource IconTileGlyph}"
                                          Data="{Binding Name, Converter={StaticResource CategoryIconConverter}}"
                                          Fill="{Binding Name, Converter={StaticResource CategoryColorConverter}}" />
                                </Border>
                                <Label Grid.Column="1"
                                       Style="{StaticResource BodyStrong}"
                                       Text="{Binding Name}"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="2" Style="{StaticResource Chip}" IsVisible="{Binding IsSystemDefault}">
                                    <Label Style="{StaticResource ChipText}" Text="SYSTEM" />
                                </Border>
                            </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="0,40" Spacing="10">
                            <Path Style="{StaticResource EmptyIcon}" Data="{StaticResource IconTag}" />
                            <Label Style="{StaticResource EmptyTitle}" Text="No categories" />
                            <Label Style="{StaticResource EmptyBody}"
                                   Text="Add one above to group your subscriptions. Swipe a row left to rename or delete it." />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Border>

        </Grid>
    </RefreshView>

</ContentPage>
