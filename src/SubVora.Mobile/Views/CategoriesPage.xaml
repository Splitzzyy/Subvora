<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:dtos="clr-namespace:SubVora.Mobile.Api.Dtos"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:SubVora.Mobile.Converters"
    x:DataType="viewModels:CategoriesViewModel"
    Title="Categories">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <converters:CategoryColorConverter x:Key="CategoryColorConverter" />
        <converters:CategoryIconConverter x:Key="CategoryIconConverter" />
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,16,16,0" RowSpacing="12">

            <Label Grid.Row="0"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource FieldBorder}">
                    <Entry Placeholder="New category" Text="{Binding NewCategoryName}" />
                </Border>
                <Button Grid.Column="1" Text="Add" Command="{Binding AddCommand}" IsEnabled="{Binding CanSubmit}" Padding="20,14" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,4" Margin="0,0,0,16">
                <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True">

                    <!-- Two sections, because these are two kinds of thing: the seeded defaults
                         every account shares, and this user's own - which are the only ones that
                         can be renamed or deleted. The heading carries that distinction, so the
                         rows no longer need a per-row SYSTEM chip. -->
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="viewModels:CategoryGroup">
                            <Grid Padding="2,16,2,8" ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Style="{StaticResource SectionHeading}"
                                       Text="{Binding Title}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Style="{StaticResource Caption}"
                                       Text="{Binding Summary}"
                                       FontSize="12"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dtos:CategoryDto">
                            <!-- Swipe is kept as the fast path, but it advertises itself to nobody,
                                 so each editable row also carries a visible manage button. Both
                                 routes are hidden for system defaults - shared by every account,
                                 and the server answers 404 for them anyway. -->
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Rename"
                                                   BackgroundColor="#512BD4"
                                                   IsVisible="{Binding IsSystemDefault, Converter={StaticResource InvertedBoolConverter}}"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CategoriesViewModel}}, Path=RenameCommand}"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Delete"
                                                   BackgroundColor="#C62828"
                                                   IsVisible="{Binding IsSystemDefault, Converter={StaticResource InvertedBoolConverter}}"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CategoriesViewModel}}, Path=DeleteCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                            <Grid Style="{StaticResource CardRow}" ColumnDefinitions="Auto,*,Auto">
                                <!-- Tile rather than the old 10px dot: at that size the colour was
                                     the only thing distinguishing one row from the next, and a hue
                                     alone cannot say "Fitness". -->
                                <Border Grid.Column="0"
                                        Style="{StaticResource IconTile}"
                                        Margin="0,0,12,0"
                                        BackgroundColor="{Binding Name, Converter={StaticResource CategoryColorConverter}, ConverterParameter=soft}">
                                    <Path Style="{StaticResource IconTileGlyph}"
                                          Data="{Binding Name, Converter={StaticResource CategoryIconConverter}}"
                                          Fill="{Binding Name, Converter={StaticResource CategoryColorConverter}}" />
                                </Border>
                                <Label Grid.Column="1"
                                       Style="{StaticResource BodyStrong}"
                                       Text="{Binding Name}"
                                       VerticalOptions="Center" />

                                <!-- The discoverable half of rename/delete. A button rather than an
                                     icon-only tap target so it reads as pressable, and only on rows
                                     that actually have actions. -->
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Text="•••"
                                        FontSize="14"
                                        Padding="12,4"
                                        MinimumHeightRequest="34"
                                        MinimumWidthRequest="44"
                                        SemanticProperties.Description="Rename or delete this category"
                                        IsVisible="{Binding IsSystemDefault, Converter={StaticResource InvertedBoolConverter}}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CategoriesViewModel}}, Path=ManageCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="0,40" Spacing="10">
                            <Path Style="{StaticResource EmptyIcon}" Data="{StaticResource IconTag}" />
                            <Label Style="{StaticResource EmptyTitle}" Text="No categories" />
                            <Label Style="{StaticResource EmptyBody}"
                                   Text="Add one above to group your subscriptions." />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Border>

            <!-- Outside the CollectionView on purpose. This hint used to live in EmptyView, which
                 renders only when the list is empty - so the one thing that explained the gesture
                 was on screen exactly when there was no row to try it on. -->
            <Label Grid.Row="3"
                   Style="{StaticResource Caption}"
                   Text="Tap ••• on one of your categories to rename or delete it, or swipe the row left."
                   Margin="4,0,4,16"
                   IsVisible="{Binding HasManageableCategories}" />

        </Grid>
    </RefreshView>

</ContentPage>
