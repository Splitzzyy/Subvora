<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:dtos="clr-namespace:SubVora.Mobile.Api.Dtos"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:SubVora.Mobile.Converters"
    x:DataType="viewModels:CategoriesViewModel"
    Title="Categories">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <converters:CategoryColorConverter x:Key="CategoryColorConverter" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <Grid RowDefinitions="Auto,Auto,*" Padding="16,16,16,0" RowSpacing="12">

            <Label Grid.Row="0"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource FieldBorder}">
                    <Entry Placeholder="New category" Text="{Binding NewCategoryName}" />
                </Border>
                <Button Grid.Column="1" Text="Add" Command="{Binding AddCommand}" Padding="20,14" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,4" Margin="0,0,0,16">
                <CollectionView ItemsSource="{Binding Categories}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dtos:CategoryDto">
                            <Grid Style="{StaticResource CardRow}" ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Grid.Column="0"
                                         WidthRequest="10" HeightRequest="10"
                                         VerticalOptions="Center"
                                         Margin="0,0,10,0"
                                         Fill="{Binding Name, Converter={StaticResource CategoryColorConverter}}" />
                                <Label Grid.Column="1"
                                       Style="{StaticResource BodyText}"
                                       Text="{Binding Name}"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="2" Style="{StaticResource Chip}" IsVisible="{Binding IsSystemDefault}">
                                    <Label Style="{StaticResource ChipText}" Text="SYSTEM" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="0,40" Spacing="10">
                            <Path Style="{StaticResource EmptyIcon}" Data="{StaticResource IconTag}" />
                            <Label Style="{StaticResource EmptyTitle}" Text="No categories" />
                            <Label Style="{StaticResource EmptyBody}"
                                   Text="Add one above to group your subscriptions." />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Border>

        </Grid>
    </RefreshView>

</ContentPage>
