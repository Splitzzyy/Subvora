<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:dtos="clr-namespace:SubVora.Mobile.Api.Dtos"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:SubVora.Mobile.Converters"
    x:DataType="viewModels:CategoriesViewModel"
    Title="Categories">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <converters:CategoryColorConverter x:Key="CategoryColorConverter" />
        <converters:CategoryIconConverter x:Key="CategoryIconConverter" />
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <Grid RowDefinitions="Auto,Auto,*" Padding="16,16,16,0" RowSpacing="14">

            <Label Grid.Row="0"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <!-- Filled field and pill button, both fully round, so the two controls read as one
                 composed action rather than a box next to a box. -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource M3FilledField}">
                    <Entry Placeholder="New category" Text="{Binding NewCategoryName}" />
                </Border>
                <Button Grid.Column="1"
                        Style="{StaticResource M3PillButton}"
                        Text="Add"
                        Command="{Binding AddCommand}"
                        IsEnabled="{Binding CanSubmit}" />
            </Grid>

            <!-- No outer card. Each row is its own container on the page background, which is what
                 gives the list its shape rhythm - one card with hairline separators inside it is
                 the treatment this replaced. -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Groups}"
                            IsGrouped="True"
                            Margin="0,0,0,16">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <!-- Two sections, because these are two kinds of thing: the seeded defaults every
                     account shares, and this user's own - the only ones that can be renamed or
                     deleted. The heading carries that distinction, so rows need no SYSTEM chip. -->
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="viewModels:CategoryGroup">
                        <Grid Padding="6,20,6,10" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource M3SectionTitle}"
                                   Text="{Binding Title}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1" Style="{StaticResource M3CountPill}">
                                <Label Style="{StaticResource M3CountPillText}" Text="{Binding Summary}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:CategoryDto">
                        <Border Style="{StaticResource M3ListItem}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                <!-- Circular, and tinted per category. The tile, its glyph and the
                                     name all agree; none of them carries identity alone, because
                                     beyond a few categories on screen no palette keeps every pair
                                     distinguishable - the label is the cue. -->
                                <Border Grid.Column="0"
                                        Style="{StaticResource M3IconCircle}"
                                        BackgroundColor="{Binding Name, Converter={StaticResource CategoryColorConverter}, ConverterParameter=soft}">
                                    <Path Style="{StaticResource M3IconCircleGlyph}"
                                          Data="{Binding Name, Converter={StaticResource CategoryIconConverter}}"
                                          Fill="{Binding Name, Converter={StaticResource CategoryColorConverter}}" />
                                </Border>

                                <Label Grid.Column="1"
                                       Style="{StaticResource BodyStrong}"
                                       Text="{Binding Name}"
                                       VerticalOptions="Center" />

                                <!-- The only route to rename/delete. Swipe used to sit alongside
                                     this and is gone: it advertised itself to nobody, and two ways
                                     into the same menu is one more than this screen needs. Drawn
                                     only on rows that have actions - the server answers 404 for a
                                     system default regardless. -->
                                <Border Grid.Column="2"
                                        Style="{StaticResource M3TonalIconButton}"
                                        IsVisible="{Binding IsSystemDefault, Converter={StaticResource InvertedBoolConverter}}"
                                        SemanticProperties.Description="Rename or delete this category">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CategoriesViewModel}}, Path=ManageCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Path Style="{StaticResource M3TonalIconButtonGlyph}" Data="{StaticResource IconMoreVert}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,48" Spacing="12">
                        <Path Style="{StaticResource EmptyIcon}" Data="{StaticResource IconTag}" />
                        <Label Style="{StaticResource EmptyTitle}" Text="No categories" />
                        <Label Style="{StaticResource EmptyBody}"
                               Text="Add one above to group your subscriptions." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

        </Grid>
    </RefreshView>

</ContentPage>
