<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.PaymentSourcesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:dtos="clr-namespace:SubVora.Mobile.Api.Dtos"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:SubVora.Mobile.Converters"
    x:DataType="viewModels:PaymentSourcesViewModel"
    Title="Payment Sources">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <converters:PaymentSourceIconConverter x:Key="PaymentSourceIconConverter" />
        <converters:PaymentSourceColorConverter x:Key="PaymentSourceColorConverter" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <Grid RowDefinitions="Auto,Auto,*" Padding="16,16,16,0" RowSpacing="12">

            <Label Grid.Row="0"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconWallet}" />
                        <Label Style="{StaticResource SectionHeading}" Text="Add a source" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Placeholder="Label — e.g. HDFC Credit ••4021" Text="{Binding NewLabel}" />
                    </Border>

                    <Border Style="{StaticResource FieldBorder}">
                        <Picker ItemsSource="{Binding SourceTypes}" SelectedItem="{Binding NewSourceType}" />
                    </Border>

                    <Label Style="{StaticResource WarningText}"
                           Text="You're offline. Changes can't be saved until you reconnect."
                           FontSize="13"
                           IsVisible="{Binding IsOffline}" />

                    <Button Text="Add" Command="{Binding AddCommand}" IsEnabled="{Binding CanSubmit}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,4" Margin="0,0,0,16">
                <CollectionView ItemsSource="{Binding PaymentSources}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dtos:PaymentSourceDto">
                            <Grid Style="{StaticResource CardRow}" ColumnDefinitions="Auto,*,Auto,Auto">
                                <!-- Tinted by type, not per row: a person's cards are not
                                     categories, and a hue each would imply a distinction the
                                     data does not have. -->
                                <Border Grid.Column="0"
                                        Style="{StaticResource IconTile}"
                                        Margin="0,0,12,0"
                                        BackgroundColor="{Binding SourceType, Converter={StaticResource PaymentSourceColorConverter}, ConverterParameter=soft}">
                                    <Path Style="{StaticResource IconTileGlyph}"
                                          Data="{Binding SourceType, Converter={StaticResource PaymentSourceIconConverter}}"
                                          Fill="{Binding SourceType, Converter={StaticResource PaymentSourceColorConverter}}" />
                                </Border>
                                <Label Grid.Column="1"
                                       Style="{StaticResource BodyStrong}"
                                       Text="{Binding Label}"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="2" Style="{StaticResource Chip}">
                                    <Label Style="{StaticResource ChipText}" Text="{Binding SourceType}" />
                                </Border>

                                <!-- The only route to rename/delete, and the same vertical-dots
                                     button the Categories rows use - one affordance means one thing
                                     on both screens. Swipe used to sit alongside it and is gone:
                                     nothing on screen announced it, and two ways into the same menu
                                     is one more than this screen needs. -->
                                <Border Grid.Column="3"
                                        Style="{StaticResource M3TonalIconButton}"
                                        Margin="8,0,0,0"
                                        SemanticProperties.Description="Rename or delete this payment source">
                                    <!-- Handled in code-behind rather than bound straight to the
                                         command: the menu is anchored to this button, and where it
                                         is on screen is a fact only the page can supply. -->
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnManageTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Path Style="{StaticResource M3TonalIconButtonGlyph}" Data="{StaticResource IconMoreVert}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="0,40" Spacing="10">
                            <Path Style="{StaticResource EmptyIcon}" Data="{StaticResource IconWallet}" />
                            <Label Style="{StaticResource EmptyTitle}" Text="No payment sources" />
                            <Label Style="{StaticResource EmptyBody}"
                                   Text="Add the cards and accounts your subscriptions bill to." />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Border>

        </Grid>
    </RefreshView>

</ContentPage>
