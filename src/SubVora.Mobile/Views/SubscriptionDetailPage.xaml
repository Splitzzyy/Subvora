<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.SubscriptionDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:dtos="clr-namespace:SubVora.Mobile.Api.Dtos"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:SubscriptionDetailViewModel"
    Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        <toolkit:IsListNullOrEmptyConverter x:Key="IsListEmptyConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,32" Spacing="16">

            <Label Style="{StaticResource ErrorText}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <!-- ===== What it is ===== -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconSparkle}" />
                        <Label Style="{StaticResource SectionHeading}" Text="Service" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource FieldLabel}" Text="Name" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding CustomName}" Placeholder="e.g. Netflix" />
                    </Border>

                    <!-- Trigram matches against the provider catalog, every one that cleared the
                         server's floor. Shown inline under the name as a pick list rather than as a
                         dialog so it never blocks typing, and as a list rather than a single "Use"
                         button because the top score is a ranking, not a decision - the user says
                         which provider this is. Tapping a row fills the form; ignoring the list
                         leaves whatever was typed. -->
                    <Border IsVisible="{Binding SuggestedTier, Converter={StaticResource IsNotNullConverter}}"
                            Style="{StaticResource Chip}"
                            Padding="12,10">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource Caption}" Text="{Binding SuggestionsHeading}" />

                            <!-- Bound to the collection, not to a fixed number of rows: the server
                                 caps the list, so there is nothing here to scroll and no height to
                                 guess at. -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:CatalogMatchCandidate">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,9">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SubscriptionDetailViewModel}}, Path=UseSuggestionCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>

                                            <Label Grid.Column="0"
                                                   Style="{StaticResource BodyStrong}"
                                                   Text="{Binding ProviderName}"
                                                   VerticalOptions="Center" />

                                            <Path Grid.Column="1"
                                                  Data="{StaticResource IconChevronRight}"
                                                  Aspect="Uniform"
                                                  WidthRequest="14" HeightRequest="14"
                                                  Fill="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                                  VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Category" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Picker Title="Choose a category"
                                ItemsSource="{Binding Categories}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedCategory}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ===== What it costs ===== -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconWallet}" />
                        <Label Style="{StaticResource SectionHeading}" Text="Cost" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="12">
                            <Label Style="{StaticResource FieldLabel}" Text="Amount" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding CostAmount}" Keyboard="Numeric" Placeholder="0.00" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="12">
                            <Label Style="{StaticResource FieldLabel}" Text="Currency" />
                            <!-- Picker, matching Settings. Typing a code means knowing it, and a
                                 typo only surfaced as a 400 after Save. This is the currency the
                                 subscription is billed in, not a preference, so it defaults to the
                                 form's own default rather than following the home currency. -->
                            <Border Style="{StaticResource FieldBorder}">
                                <Picker ItemsSource="{Binding Currencies}"
                                        SelectedItem="{Binding SelectedCurrency}"
                                        ItemDisplayBinding="{Binding Display}"
                                        Title="Select a currency" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Style="{StaticResource FieldLabel}" Text="Billing cycle" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Picker Title="How often it bills"
                                ItemsSource="{Binding BillingCycleTypes}"
                                SelectedItem="{Binding CycleCadence}" />
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Payment source" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Picker Title="Choose a payment source"
                                ItemsSource="{Binding PaymentSources}"
                                ItemDisplayBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedPaymentSource}" />
                    </Border>
                    <!-- An empty Picker opens an empty dialog and looks broken. Say why it is empty
                         and where to fix it, rather than leaving the user tapping a dead control. -->
                    <Label Style="{StaticResource Caption}"
                           Text="No payment sources yet — add one on the Payment tab, then come back. Optional either way."
                           Margin="4,0,0,0"
                           IsVisible="{Binding PaymentSources, Converter={StaticResource IsListEmptyConverter}}" />

                    <Grid ColumnDefinitions="*,Auto" Margin="4,4,0,0">
                        <Label Grid.Column="0" Style="{StaticResource BodyText}" Text="Free trial" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsFreeTrial}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ===== When it bills ===== -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconCalendar}" />
                        <Label Style="{StaticResource SectionHeading}" Text="Dates &amp; reminders" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource FieldLabel}" Text="Purchase date" />
                    <Border Style="{StaticResource FieldBorder}">
                        <DatePicker Date="{Binding PurchaseDate}" />
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="Next billing date" />
                    <Border Style="{StaticResource FieldBorder}">
                        <DatePicker Date="{Binding NextBillingDate}" />
                    </Border>
                    <Label Style="{StaticResource Caption}"
                           Text="One billing period after the purchase date. Change it if your provider bills on a different day."
                           Margin="4,0,0,0" />

                    <Label Style="{StaticResource FieldLabel}" Text="Remind me this many days ahead" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding AlertDaysAdvance}" Keyboard="Numeric" Placeholder="3" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSubmit}" />

            <!-- Edit mode only: there is nothing to delete on a record that has not been created. -->
            <Border Style="{StaticResource Card}"
                    Padding="6"
                    IsVisible="{Binding IsEditMode}">
                <Button Style="{StaticResource DangerButton}"
                        Text="Delete subscription"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanSubmit}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
