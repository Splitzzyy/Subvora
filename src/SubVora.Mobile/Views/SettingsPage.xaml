<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:SettingsViewModel"
    Title="Settings">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,32" Spacing="16">

            <Label Style="{StaticResource ErrorText}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconSliders}" />
                        <Label Style="{StaticResource SectionHeading}" Text="Preferences" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource FieldLabel}" Text="Home currency" />
                    <!-- Picker, not a three-letter Entry: typing a code means knowing it, and a typo
                         only surfaced as a validation error after Save. ItemDisplayBinding shows the
                         symbol, code and name together while the bound selection keeps the code. -->
                    <Border Style="{StaticResource FieldBorder}">
                        <Picker ItemsSource="{Binding Currencies}"
                                SelectedItem="{Binding SelectedCurrency}"
                                ItemDisplayBinding="{Binding Display}"
                                Title="Select a currency" />
                    </Border>
                    <Label Style="{StaticResource Caption}"
                           Text="Everything on the dashboard is converted into this currency. Your subscriptions keep the currency they are billed in."
                           Margin="4,0,0,0" />

                    <Label Style="{StaticResource FieldLabel}" Text="Default reminder lead time (days)" Margin="4,8,0,-4" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding DefaultAlertDaysAdvance}" Keyboard="Numeric" Placeholder="3" />
                    </Border>

                    <Label Style="{StaticResource WarningText}"
                           Text="You're offline. Changes can't be saved until you reconnect."
                           FontSize="13"
                           IsVisible="{Binding IsOffline}" />

                    <Button Text="Save"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSubmit}"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Separate card from Preferences: appearance is stored on this device and applies as
                 soon as it is picked, so it must not look like it is waiting on the Save button
                 above. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconSparkle}" />
                        <Label Style="{StaticResource SectionHeading}" Text="Appearance" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Border Style="{StaticResource FieldBorder}">
                        <Picker Title="Choose an appearance"
                                ItemsSource="{Binding Themes}"
                                SelectedItem="{Binding Theme}" />
                    </Border>

                    <Label Style="{StaticResource Caption}"
                           Text="System follows your phone's light/dark setting. Applies straight away and is remembered on this device."
                           Margin="4,0,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Its own card, and its own message pair: a failure here must not look like the
                 preferences above failed to save, and vice versa. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconCheckCircle}" />
                        <Label Style="{StaticResource SectionHeading}" Text="Password" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource FieldLabel}" Text="Current password" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding CurrentPassword}" IsPassword="True" /> <!-- pragma: allowlist secret -->
                    </Border>

                    <Label Style="{StaticResource FieldLabel}" Text="New password" Margin="4,8,0,-4" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="At least 8 characters" /> <!-- pragma: allowlist secret -->
                    </Border>

                    <Label Style="{StaticResource Caption}"
                           Text="{Binding PasswordMessage}"
                           IsVisible="{Binding PasswordMessage, Converter={StaticResource StringToBoolConverter}}" />

                    <Label Style="{StaticResource ErrorText}"
                           Text="{Binding PasswordErrorMessage}"
                           IsVisible="{Binding PasswordErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                    <Label Style="{StaticResource Caption}"
                           Text="Changing your password signs out every other device. This one stays signed in."
                           Margin="4,0,0,0" />

                    <Button Text="Change password"
                            Command="{Binding ChangePasswordCommand}"
                            IsEnabled="{Binding CanSubmit}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="8">
                <Button Style="{StaticResource DangerButton}"
                        Text="Sign out"
                        Command="{Binding SignOutCommand}" />
            </Border>

            <!-- Which build this is. Deliberately populated from code-behind rather than the view
                 model: AppInfo.Current is a static platform accessor with no counterpart in a plain
                 xUnit host, and there is no logic here for a test to catch. See SettingsPage.xaml.cs.

                 The pair matters together - the release workflow sets the display version from the
                 git tag and the build number from the CI run number, so "1.1.0 (build 7)" names one
                 specific artifact. That is the thing worth asking a bug reporter for. -->
            <VerticalStackLayout Spacing="2" Padding="4,4,4,0" HorizontalOptions="Center">
                <Label x:Name="VersionLabel"
                       Style="{StaticResource Caption}"
                       HorizontalTextAlignment="Center"
                       SemanticProperties.Description="Installed app version" />
                <Label x:Name="PackageLabel"
                       Style="{StaticResource Caption}"
                       FontSize="11"
                       HorizontalTextAlignment="Center"
                       Opacity="0.7" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
