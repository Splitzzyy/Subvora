<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:SettingsViewModel"
    Title="Settings">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,32" Spacing="16">

            <Label Style="{StaticResource ErrorText}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconSliders}" />
                        <Label Style="{StaticResource SectionHeading}" Text="Preferences" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource FieldLabel}" Text="Home currency" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding PreferredCurrency}" Placeholder="INR" MaxLength="3" />
                    </Border>
                    <Label Style="{StaticResource Caption}"
                           Text="Everything on the dashboard is converted into this currency. Your subscriptions keep the currency they are billed in."
                           Margin="4,0,0,0" />

                    <Label Style="{StaticResource FieldLabel}" Text="Default reminder lead time (days)" Margin="4,8,0,-4" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding DefaultAlertDaysAdvance}" Keyboard="Numeric" Placeholder="3" />
                    </Border>

                    <Button Text="Save"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Separate card from Preferences: appearance is stored on this device and applies as
                 soon as it is picked, so it must not look like it is waiting on the Save button
                 above. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconSparkle}" />
                        <Label Style="{StaticResource SectionHeading}" Text="Appearance" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Border Style="{StaticResource FieldBorder}">
                        <Picker Title="Choose an appearance"
                                ItemsSource="{Binding Themes}"
                                SelectedItem="{Binding Theme}" />
                    </Border>

                    <Label Style="{StaticResource Caption}"
                           Text="System follows your phone's light/dark setting. Applies straight away and is remembered on this device."
                           Margin="4,0,0,0" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="8">
                <Button Style="{StaticResource DangerButton}"
                        Text="Sign out"
                        Command="{Binding SignOutCommand}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
