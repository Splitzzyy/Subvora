<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.SubscriptionListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:dtos="clr-namespace:SubVora.Mobile.Api.Dtos"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:SubscriptionListViewModel"
    Title="Subscriptions">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <Grid RowDefinitions="Auto,Auto,*">

            <Label Grid.Row="0"
                   Text="Offline — showing last synced data"
                   TextColor="OrangeRed"
                   FontAttributes="Italic"
                   Margin="20,10,20,0"
                   IsVisible="{Binding IsShowingCachedData}" />

            <Label Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   Margin="20,10,20,0"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <CollectionView Grid.Row="2" ItemsSource="{Binding Subscriptions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:SubscriptionDto">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="Red"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SubscriptionListViewModel}}, Path=DeleteSubscriptionCommand}"
                                               CommandParameter="{Binding Id}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid Padding="20,12" ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SubscriptionListViewModel}}, Path=SelectSubscriptionCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Grid.GestureRecognizers>

                                <!-- The placeholder sits underneath and is simply never covered when
                                     CatalogLogoUrl is null/empty, or when the remote image fails to
                                     load: MAUI leaves an Image with an unreachable UriImageSource
                                     blank rather than throwing, so a dead URL or a fully offline
                                     device degrades to the fallback with no extra handling. -->
                                <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                    <Image Source="subscription_placeholder.png" Aspect="AspectFit" />
                                    <Image Source="{Binding CatalogLogoUrl}"
                                           Aspect="AspectFit"
                                           IsVisible="{Binding CatalogLogoUrl, Converter={StaticResource StringToBoolConverter}}" />
                                </Grid>

                                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8">
                                    <Label Text="{Binding CustomName}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Border IsVisible="{Binding IsFreeTrial}"
                                            BackgroundColor="{StaticResource Primary}"
                                            StrokeThickness="0"
                                            Padding="6,2"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="TRIAL" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Grid.Row="0" Grid.Column="2" Text="{Binding CostAmount, StringFormat='{0:N2}'}" />

                                <Label Grid.Row="1" Grid.Column="1">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding CategoryName}" />
                                            <Span Text=" · Next: " />
                                            <Span Text="{Binding NextBillingDate}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding Currency}" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </RefreshView>

</ContentPage>
