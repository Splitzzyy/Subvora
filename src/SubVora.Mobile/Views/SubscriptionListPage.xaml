<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.SubscriptionListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:dtos="clr-namespace:SubVora.Mobile.Api.Dtos"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:SubVora.Mobile.Converters"
    x:DataType="viewModels:SubscriptionListViewModel"
    Title="Subscriptions">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <converters:CategoryColorConverter x:Key="CategoryColorConverter" />
        <converters:RelativeDateConverter x:Key="RelativeDateConverter" />
        <converters:InitialConverter x:Key="InitialConverter" />
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <!--
        The primary action is the floating button at the bottom right, not a toolbar word. It sits
        over the list rather than inside it so it stays put while the list scrolls.
    -->
    <Grid>
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <Grid RowDefinitions="Auto,Auto,*">

            <Label Grid.Row="0"
                   Style="{StaticResource Caption}"
                   Text="Offline — showing last synced data"
                   FontAttributes="Italic"
                   Margin="20,12,20,0"
                   IsVisible="{Binding IsShowingCachedData}" />

            <Label Grid.Row="1"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding ErrorMessage}"
                   Margin="20,12,20,0"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <!--
                Grouped by category, and both the groups and the rows inside them are ordered by
                billing date - so whatever is charged next is at the top of the screen. See
                SubscriptionListViewModel.RebuildGroups.
            -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Groups}"
                            IsGrouped="True"
                            Margin="0,12,0,0">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="viewModels:SubscriptionGroup">
                        <Grid Padding="20,16,20,8" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Ellipse Grid.Column="0"
                                     WidthRequest="10" HeightRequest="10"
                                     VerticalOptions="Center"
                                     Fill="{Binding CategoryName, Converter={StaticResource CategoryColorConverter}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Style="{StaticResource SectionHeading}" Text="{Binding CategoryName}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding Summary}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:SubscriptionDto">
                        <SwipeView Margin="16,0,16,10">
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="#C62828"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SubscriptionListViewModel}}, Path=DeleteSubscriptionCommand}"
                                               CommandParameter="{Binding Id}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Style="{StaticResource Card}" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SubscriptionListViewModel}}, Path=SelectSubscriptionCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnSpacing="12" ColumnDefinitions="Auto,Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                                    <!-- Says the row opens something. Without it a card reads as a
                                         label, which is how the edit screen went unfound. -->
                                    <Path Grid.Row="0" Grid.Column="4" Grid.RowSpan="3"
                                          Style="{StaticResource ChevronIcon}"
                                          Data="{StaticResource IconChevronRight}" />

                                    <!-- Category as a stripe down the row: same colour the group
                                         header and the dashboard breakdown use, so a row still
                                         carries its category once it has scrolled away from its
                                         header. -->
                                    <Rectangle Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                               WidthRequest="4"
                                               RadiusX="2" RadiusY="2"
                                               VerticalOptions="Fill"
                                               Fill="{Binding CategoryName, Converter={StaticResource CategoryColorConverter}}" />

                                    <!-- Drawn on the device rather than fetched. The catalog's
                                         CatalogLogoUrl points at a Simple Icons SVG, and MAUI hands
                                         remote images to Android's bitmap decoder, which cannot read
                                         SVG - Glide logged "Failed to load resource" and the tile
                                         stayed empty. A letter needs no network, so it survives the
                                         offline path this list already supports, and every row gets
                                         one whether or not it matched the catalog. -->
                                    <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                            Style="{StaticResource Chip}"
                                            Padding="0"
                                            WidthRequest="44" HeightRequest="44"
                                            VerticalOptions="Center"
                                            BackgroundColor="{Binding CategoryName, Converter={StaticResource CategoryColorConverter}, ConverterParameter=soft}">
                                        <Label Text="{Binding CustomName, Converter={StaticResource InitialConverter}}"
                                               Style="{StaticResource BodyStrong}"
                                               FontSize="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="2" Spacing="8">
                                        <Label Style="{StaticResource BodyStrong}"
                                               Text="{Binding CustomName}"
                                               FontSize="16"
                                               VerticalOptions="Center" />
                                        <Border Style="{StaticResource TrialChip}" IsVisible="{Binding IsFreeTrial}">
                                            <Label Style="{StaticResource TrialChipText}" Text="TRIAL" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <Label Grid.Row="0" Grid.Column="3"
                                           Style="{StaticResource BodyStrong}"
                                           FontSize="16"
                                           VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Currency}" FontSize="12" />
                                                <Span Text=" " />
                                                <Span Text="{Binding CostAmount, StringFormat='{0:N2}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- The category lives in the group header now, so the row's
                                         second line answers the question the list is for: is this
                                         paid, and if not, when is it due. -->
                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Spacing="8">
                                        <Label Style="{StaticResource Caption}"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsOverdue, Converter={StaticResource InvertedBoolConverter}}"
                                               Text="{Binding NextBillingDate, Converter={StaticResource RelativeDateConverter}, StringFormat='Renews {0}'}" />

                                        <!-- Word plus colour, never colour alone. -->
                                        <Border Style="{StaticResource OverdueChip}" IsVisible="{Binding IsOverdue}">
                                            <Label Style="{StaticResource OverdueChipText}" Text="OVERDUE" />
                                        </Border>

                                        <!-- A plain date, not the relative phrasing: the chip beside
                                             it already says it is late, and "was due overdue since
                                             1 Aug" is what nesting the two would produce. -->
                                        <Label Style="{StaticResource Caption}"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsOverdue}"
                                               Text="{Binding NextBillingDate, StringFormat='was due {0:d MMM yyyy}'}" />
                                    </HorizontalStackLayout>

                                    <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                            Style="{StaticResource SecondaryButton}"
                                            Text="Mark as paid"
                                            FontSize="14"
                                            Padding="14,8"
                                            MinimumHeightRequest="38"
                                            HorizontalOptions="Start"
                                            Margin="0,8,0,0"
                                            IsVisible="{Binding IsOverdue}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SubscriptionListViewModel}}, Path=MarkPaidCommand}"
                                            CommandParameter="{Binding Id}" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40,60" Spacing="12">
                        <Path Style="{StaticResource EmptyIcon}" Data="{StaticResource IconInbox}" />
                        <Label Style="{StaticResource EmptyTitle}" Text="No subscriptions yet" />
                        <Label Style="{StaticResource EmptyBody}"
                               Text="Tap + to track your first one. Swipe a row left to delete it." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

        </Grid>
    </RefreshView>

    <Border Style="{StaticResource Fab}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding AddCommand}" />
        </Border.GestureRecognizers>
        <Path Style="{StaticResource FabIcon}" Data="{StaticResource IconPlus}" />
    </Border>
    </Grid>

</ContentPage>
