<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SubVora.Mobile.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:SubVora.Mobile.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:ForgotPasswordViewModel"
    Title="Reset password">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*">

            <VerticalStackLayout Grid.Row="1" Spacing="20">

                <VerticalStackLayout Spacing="4" Margin="0,0,0,8">
                    <Label Style="{StaticResource Display}" Text="Reset password" HorizontalTextAlignment="Center" />
                    <Label Style="{StaticResource Caption}"
                           Text="We'll email you a code to set a new one."
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <Label Style="{StaticResource FieldLabel}" Text="Email" />
                        <Border Style="{StaticResource FieldBorder}">
                            <!-- Locked once a code is out: the code was issued against this address,
                                 so editing it here would only produce a mismatch the server rejects. -->
                            <Entry Text="{Binding Email}"
                                   Placeholder="you@example.com"
                                   Keyboard="Email"
                                   IsEnabled="{Binding CodeSent, Converter={StaticResource InvertedBoolConverter}}" />
                        </Border>

                        <VerticalStackLayout Spacing="12" IsVisible="{Binding CodeSent}">
                            <Label Style="{StaticResource FieldLabel}" Text="6-digit code" Margin="4,8,0,-4" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding Code}"
                                       Placeholder="123456"
                                       Keyboard="Numeric"
                                       MaxLength="6" />
                            </Border>

                            <Label Style="{StaticResource FieldLabel}" Text="New password" Margin="4,8,0,-4" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="At least 8 characters" /> <!-- pragma: allowlist secret -->
                            </Border>
                        </VerticalStackLayout>

                        <Label Style="{StaticResource Caption}"
                               Text="{Binding InfoMessage}"
                               IsVisible="{Binding InfoMessage, Converter={StaticResource StringToBoolConverter}}" />

                        <Label Style="{StaticResource ErrorText}"
                               Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                        <Label Style="{StaticResource WarningText}"
                               Text="You're offline. Reset needs a connection."
                               FontSize="13"
                               IsVisible="{Binding IsOffline}" />

                        <Button Text="Send code"
                                Command="{Binding RequestCodeCommand}"
                                IsEnabled="{Binding CanSubmit}"
                                IsVisible="{Binding CodeSent, Converter={StaticResource InvertedBoolConverter}}" />

                        <Button Text="Set new password"
                                Command="{Binding ResetCommand}"
                                IsEnabled="{Binding CanSubmit}"
                                IsVisible="{Binding CodeSent}" />

                        <Button Style="{StaticResource LinkButton}"
                                Text="Send another code"
                                Command="{Binding RequestCodeCommand}"
                                IsEnabled="{Binding CanSubmit}"
                                IsVisible="{Binding CodeSent}" />
                    </VerticalStackLayout>
                </Border>

                <Button Style="{StaticResource LinkButton}"
                        Text="Back to sign in"
                        Clicked="OnBackToLoginTapped" />

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
