<?xml version="1.0" encoding="UTF-8" ?>
<!--
    SubVora's own layer on top of the stock MAUI template dictionaries. Merged after Colors.xaml and
    Styles.xaml in App.xaml, so the implicit styles here win where they overlap (notably Shell, whose
    template default paints the selected tab magenta).

    Everything is defined as an AppThemeBinding pair. A colour that only exists for one theme shows up
    as unreadable text the moment the phone is in the other one, which is not a hypothetical on
    Android - the system toggle is one swipe away in the notification shade.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Icon geometry =====
         Path data rather than image files: a Path takes a theme-bound Fill, so one definition works
         on both light and dark instead of needing a second asset. 24x24 viewBox throughout, so every
         icon is drawn inside a 24x24 Path with Aspect="Uniform". -->

    <!-- Interface icons. Material Design's own 24dp geometry, transcribed as path data rather than
         shipped as the icon font: a Path takes a theme-bound Fill, where a font glyph is a Label
         whose colour has to be set at every call site. Same shapes, one definition per icon. -->

    <PathGeometry x:Key="IconPlus" Figures="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
    <PathGeometry x:Key="IconChevronRight" Figures="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" />
    <PathGeometry x:Key="IconCalendar" Figures="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z" />
    <PathGeometry x:Key="IconWallet" Figures="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" />
    <PathGeometry x:Key="IconTrash" Figures="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
    <PathGeometry x:Key="IconInbox" Figures="M19 3H4.99c-1.11 0-1.98.89-1.98 2L3 19c0 1.1.88 2 1.99 2H19c1.1 0 2-.9 2-2V5c0-1.11-.9-2-2-2zm0 12h-4c0 1.66-1.35 3-3 3s-3-1.34-3-3H4.99V5H19v10z" />
    <PathGeometry x:Key="IconTag" Figures="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58s1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41s-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z" />
    <PathGeometry x:Key="IconSliders" Figures="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" />
    <PathGeometry x:Key="IconSparkle" Figures="M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z" />
    <PathGeometry x:Key="IconTrendingUp" Figures="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z" />
    <PathGeometry x:Key="IconSchedule" Figures="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" />
    <PathGeometry x:Key="IconCheckCircle" Figures="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
    <PathGeometry x:Key="IconNotifications" Figures="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" />

    <!-- Payment-source icons, one per PaymentSourceType. See PaymentSourceIconConverter. -->
    <PathGeometry x:Key="IconCreditCard" Figures="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" />
    <PathGeometry x:Key="IconBank" Figures="M4 10h3v7H4zm6.5 0h3v7h-3zM2 19h20v3H2zM17 10h3v7h-3zm-5-9L2 6v2h20V6z" />
    <PathGeometry x:Key="IconPayments" Figures="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1.41 16.09V20h-2.67v-1.93c-1.71-.36-3.16-1.46-3.27-3.4h1.96c.1 1.05.82 1.87 2.65 1.87 1.96 0 2.4-.98 2.4-1.59 0-.83-.44-1.61-2.67-2.14-2.48-.6-4.18-1.62-4.18-3.67 0-1.72 1.39-2.84 3.11-3.21V4h2.67v1.95c1.86.45 2.79 1.86 2.85 3.39H14.3c-.05-1.11-.64-1.87-2.22-1.87-1.5 0-2.4.68-2.4 1.64 0 .84.65 1.39 2.67 1.91s4.18 1.39 4.18 3.91c-.01 1.83-1.38 2.83-3.12 3.16z" />

    <!-- Category icons, one per seeded system category. See CategoryIconConverter. -->
    <PathGeometry x:Key="IconMovie" Figures="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z" />
    <PathGeometry x:Key="IconRestaurant" Figures="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z" />
    <PathGeometry x:Key="IconFitness" Figures="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29z" />
    <PathGeometry x:Key="IconBolt" Figures="M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.96 17.55 11 21 11 21z" />
    <PathGeometry x:Key="IconFlight" Figures="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" />
    <PathGeometry x:Key="IconWork" Figures="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" />
    <PathGeometry x:Key="IconCategory" Figures="M12 2l-5.5 9h11L12 2zm5.5 20c2.49 0 4.5-2.01 4.5-4.5S19.99 13 17.5 13 13 15.01 13 17.5s2.01 4.5 4.5 4.5zM3 21.5h8v-8H3v8z" />

    <!-- ===== Tokens ===== -->

    <Color x:Key="BrandPurple">#512BD4</Color>
    <Color x:Key="BrandPurpleLight">#7C5CE0</Color>
    <Color x:Key="BrandPurpleSoft">#EDE9FB</Color>

    <Color x:Key="PageBackgroundLight">#F4F5F9</Color>
    <Color x:Key="PageBackgroundDark">#111114</Color>

    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1C1C21</Color>

    <Color x:Key="SurfaceMutedLight">#F0F1F6</Color>
    <Color x:Key="SurfaceMutedDark">#26262D</Color>

    <Color x:Key="HairlineLight">#E4E5ED</Color>
    <Color x:Key="HairlineDark">#32323B</Color>

    <Color x:Key="TextStrongLight">#16161C</Color>
    <Color x:Key="TextStrongDark">#F3F3F6</Color>

    <Color x:Key="TextMutedLight">#6A6A78</Color>
    <Color x:Key="TextMutedDark">#9C9CAB</Color>

    <Color x:Key="DangerLight">#C62828</Color>
    <Color x:Key="DangerDark">#FF7A70</Color>

    <Color x:Key="WarningLight">#B25E00</Color>
    <Color x:Key="WarningDark">#FFB570</Color>

    <Color x:Key="SuccessLight">#1B7F5A</Color>
    <Color x:Key="SuccessDark">#4CD9A4</Color>

    <!-- Accents for the dashboard's stat tiles. Each tile already carries its own word, so these
         only need to be distinguishable from one another and readable on their own soft wash - they
         are not a categorical scale and nothing is identified by hue alone. -->
    <Color x:Key="AccentBlueLight">#1F6FEB</Color>
    <Color x:Key="AccentBlueDark">#5AA0FF</Color>
    <Color x:Key="AccentBlueSoftLight">#E4EEFE</Color>
    <Color x:Key="AccentBlueSoftDark">#152A45</Color>

    <Color x:Key="AccentTealLight">#0E8A80</Color>
    <Color x:Key="AccentTealDark">#3FD0C3</Color>
    <Color x:Key="AccentTealSoftLight">#DDF3F1</Color>
    <Color x:Key="AccentTealSoftDark">#0F2E2C</Color>

    <Color x:Key="AccentAmberLight">#B26A00</Color>
    <Color x:Key="AccentAmberDark">#F5B33C</Color>
    <Color x:Key="AccentAmberSoftLight">#FDF0DC</Color>
    <Color x:Key="AccentAmberSoftDark">#3A2A10</Color>

    <!-- ===== Shell chrome ===== -->

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="#FFFFFF" />
        <Setter Property="Shell.TitleColor" Value="#FFFFFF" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="Shell.UnselectedColor" Value="#D8D2F5" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" />
        <Setter Property="Shell.NavBarIsVisible" Value="True" />
    </Style>

    <!-- ===== Typography ===== -->

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
    </Style>

    <Style x:Key="BodyStrong" TargetType="Label" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="4,0,0,-4" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
    </Style>

    <Style x:Key="WarningText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
    </Style>

    <!-- ===== Containers ===== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The dashboard hero. A short two-stop ramp within the brand hue, not a rainbow: it gives the
         card depth without putting a second colour meaning on screen. -->
    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6A3FE0" Offset="0.0" />
                    <GradientStop Color="#4520B8" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rows inside a card: the card already owns the outer padding, so these only add rhythm. -->
    <Style x:Key="CardRow" TargetType="Grid">
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="Hairline" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- Small pill used for TRIAL / System / card-type markers. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPurpleSoft}, Dark={StaticResource SurfaceMutedDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipText" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
    </Style>

    <!-- Amber, from the status palette rather than the categorical one - a trial is a state ("ends
         soon, then you pay"), not another category, and it always ships with the TRIAL label so the
         colour never has to carry the meaning by itself. -->
    <Style x:Key="TrialChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF1D6, Dark=#4A3410}" />
    </Style>

    <Style x:Key="TrialChipText" TargetType="Label" BasedOn="{StaticResource ChipText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#8A5A00, Dark=#FAB219}" />
    </Style>

    <!-- Critical, from the status palette: an unpaid charge is a state that wants acting on, and it
         is deliberately not any categorical hue - a category must never be mistaken for a problem.
         Always paired with the word OVERDUE, so the colour never carries the meaning alone. -->
    <Style x:Key="OverdueChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FBE3E3, Dark=#4A1D1D}" />
    </Style>

    <Style x:Key="OverdueChipText" TargetType="Label" BasedOn="{StaticResource ChipText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
    </Style>

    <!-- Recessive track so the filled portion is what the eye lands on. -->
    <Style TargetType="ProgressBar">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" />
        <Setter Property="HeightRequest" Value="4" />
    </Style>

    <!-- ===== Inputs =====
         Android's native Entry gives no control over its own background or corner radius, so the
         visual treatment lives on a wrapping Border and the Entry itself stays transparent. -->

    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceMutedDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- ===== Buttons ===== -->

    <!-- Keyed, because MAUI cannot express BasedOn against an implicit style the way WPF's
         {StaticResource {x:Type Button}} does. The implicit style below just adopts it. -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="50" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPurpleSoft}, Dark={StaticResource SurfaceMutedDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
    </Style>

    <!-- ===== Icons =====
         Aspect Uniform against a 24x24 viewBox, so WidthRequest/HeightRequest set the drawn size. -->

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="HeightRequest" Value="18" />
        <Setter Property="WidthRequest" Value="18" />
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SectionIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="HeightRequest" Value="16" />
        <Setter Property="WidthRequest" Value="16" />
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
    </Style>

    <!-- Deliberately faint: an empty state should read as "nothing here yet", not as an error. -->
    <Style x:Key="EmptyIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
    </Style>

    <!-- Marks a row as tappable. Without it a card looks like a label, which is why the detail
         screen went unfound. -->
    <Style x:Key="ChevronIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="HeightRequest" Value="14" />
        <Setter Property="WidthRequest" Value="14" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- ===== Floating action button =====
         Android's convention for the one primary action on a screen, and far harder to miss than a
         word in the toolbar. -->

    <Style x:Key="Fab" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="WidthRequest" Value="58" />
        <Setter Property="HeightRequest" Value="58" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Margin" Value="0,0,20,24" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="29" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#512BD4" Offset="0,4" Radius="12" Opacity="0.45" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FabIcon" TargetType="Path">
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="HeightRequest" Value="26" />
        <Setter Property="WidthRequest" Value="26" />
        <Setter Property="Fill" Value="#FFFFFF" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ===== Icon tiles =====
         A filled rounded square carrying one icon, used wherever a row identifies a thing: a
         category, a payment source, a stat. It gives every list a consistent left edge and an anchor
         for the item's colour, which a bare 10px dot could not carry.

         Square rather than circular on purpose - a circle reads as an avatar (a person, a brand
         logo), and the subscription list already uses circles for exactly that. The two must not
         look like the same kind of thing.

         The wash behind the glyph is the item's own colour at low alpha, and the glyph is the same
         colour at full strength, so contrast holds in both themes without a second palette. -->

    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <!-- Squircle, not a pill: rounded enough to sit with the cards, square enough to
                     stay a tile at 42px. -->
                <RoundRectangle CornerRadius="13" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconTileSmall" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="WidthRequest" Value="34" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="11" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconTileGlyph" TargetType="Path">
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="HeightRequest" Value="21" />
        <Setter Property="WidthRequest" Value="21" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>

    <Style x:Key="IconTileGlyphSmall" TargetType="Path" BasedOn="{StaticResource IconTileGlyph}">
        <Setter Property="HeightRequest" Value="17" />
        <Setter Property="WidthRequest" Value="17" />
    </Style>

    <!-- ===== Stat tiles =====
         The three figures under the dashboard hero. Each is its own small card so the numbers stop
         reading as one undifferentiated row of text. -->

    <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="Padding" Value="12,14" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatValue" TargetType="Label">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
    </Style>

    <Style x:Key="StatLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>

    <!-- ===== Empty states ===== -->

    <Style x:Key="EmptyTitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
    </Style>

    <Style x:Key="EmptyBody" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
