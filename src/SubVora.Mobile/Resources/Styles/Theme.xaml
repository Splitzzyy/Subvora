<?xml version="1.0" encoding="UTF-8" ?>
<!--
    SubVora's own layer on top of the stock MAUI template dictionaries. Merged after Colors.xaml and
    Styles.xaml in App.xaml, so the implicit styles here win where they overlap (notably Shell, whose
    template default paints the selected tab magenta).

    Everything is defined as an AppThemeBinding pair. A colour that only exists for one theme shows up
    as unreadable text the moment the phone is in the other one, which is not a hypothetical on
    Android - the system toggle is one swipe away in the notification shade.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Tokens ===== -->

    <Color x:Key="BrandPurple">#512BD4</Color>
    <Color x:Key="BrandPurpleLight">#7C5CE0</Color>
    <Color x:Key="BrandPurpleSoft">#EDE9FB</Color>

    <Color x:Key="PageBackgroundLight">#F4F5F9</Color>
    <Color x:Key="PageBackgroundDark">#111114</Color>

    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1C1C21</Color>

    <Color x:Key="SurfaceMutedLight">#F0F1F6</Color>
    <Color x:Key="SurfaceMutedDark">#26262D</Color>

    <Color x:Key="HairlineLight">#E4E5ED</Color>
    <Color x:Key="HairlineDark">#32323B</Color>

    <Color x:Key="TextStrongLight">#16161C</Color>
    <Color x:Key="TextStrongDark">#F3F3F6</Color>

    <Color x:Key="TextMutedLight">#6A6A78</Color>
    <Color x:Key="TextMutedDark">#9C9CAB</Color>

    <Color x:Key="DangerLight">#C62828</Color>
    <Color x:Key="DangerDark">#FF7A70</Color>

    <Color x:Key="WarningLight">#B25E00</Color>
    <Color x:Key="WarningDark">#FFB570</Color>

    <!-- ===== Shell chrome ===== -->

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="#FFFFFF" />
        <Setter Property="Shell.TitleColor" Value="#FFFFFF" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="Shell.UnselectedColor" Value="#D8D2F5" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" />
        <Setter Property="Shell.NavBarIsVisible" Value="True" />
    </Style>

    <!-- ===== Typography ===== -->

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
    </Style>

    <Style x:Key="BodyStrong" TargetType="Label" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="4,0,0,-4" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
    </Style>

    <Style x:Key="WarningText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
    </Style>

    <!-- ===== Containers ===== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The dashboard hero. A short two-stop ramp within the brand hue, not a rainbow: it gives the
         card depth without putting a second colour meaning on screen. -->
    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6A3FE0" Offset="0.0" />
                    <GradientStop Color="#4520B8" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rows inside a card: the card already owns the outer padding, so these only add rhythm. -->
    <Style x:Key="CardRow" TargetType="Grid">
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="Hairline" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- Small pill used for TRIAL / System / card-type markers. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPurpleSoft}, Dark={StaticResource SurfaceMutedDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipText" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
    </Style>

    <!-- Amber, from the status palette rather than the categorical one - a trial is a state ("ends
         soon, then you pay"), not another category, and it always ships with the TRIAL label so the
         colour never has to carry the meaning by itself. -->
    <Style x:Key="TrialChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF1D6, Dark=#4A3410}" />
    </Style>

    <Style x:Key="TrialChipText" TargetType="Label" BasedOn="{StaticResource ChipText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#8A5A00, Dark=#FAB219}" />
    </Style>

    <!-- Critical, from the status palette: an unpaid charge is a state that wants acting on, and it
         is deliberately not any categorical hue - a category must never be mistaken for a problem.
         Always paired with the word OVERDUE, so the colour never carries the meaning alone. -->
    <Style x:Key="OverdueChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FBE3E3, Dark=#4A1D1D}" />
    </Style>

    <Style x:Key="OverdueChipText" TargetType="Label" BasedOn="{StaticResource ChipText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
    </Style>

    <!-- Recessive track so the filled portion is what the eye lands on. -->
    <Style TargetType="ProgressBar">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" />
        <Setter Property="HeightRequest" Value="4" />
    </Style>

    <!-- ===== Inputs =====
         Android's native Entry gives no control over its own background or corner radius, so the
         visual treatment lives on a wrapping Border and the Entry itself stays transparent. -->

    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceMutedDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- ===== Buttons ===== -->

    <!-- Keyed, because MAUI cannot express BasedOn against an implicit style the way WPF's
         {StaticResource {x:Type Button}} does. The implicit style below just adopts it. -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="50" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPurpleSoft}, Dark={StaticResource SurfaceMutedDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandPurple}, Dark={StaticResource BrandPurpleLight}}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
    </Style>

    <!-- ===== Empty states ===== -->

    <Style x:Key="EmptyTitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextStrongLight}, Dark={StaticResource TextStrongDark}}" />
    </Style>

    <Style x:Key="EmptyBody" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
