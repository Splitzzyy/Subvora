{
  "expo": {
    "name": "SubVora",
    "slug": "subvora",
    "scheme": "subvora",
    "version": "2.1.2",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0A1F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.subvora.mobile"
    },
    "android": {
      "package": "com.subvora.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0A1F",
        "backgroundImage": "./assets/brand/adaptive-background.png",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.c2dm.permission.RECEIVE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#7B5CFF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon-light.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#FCF8FF",
          "dark": {
            "image": "./assets/brand/splash-icon.png",
            "backgroundColor": "#0B0A1F"
          }
        }
      ],
      "./plugins/with-brand-accent",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraBold.ttf"
          ]
        }
      ]
    ]
  }
}
